import { NextResponse } from 'next/server';

export async function GET() {
  const apiKey = process.env.STOCK_API_KEY;

  if (!apiKey) {
    return NextResponse.json({ success: false, error: 'API key not configured' }, { status: 500 });
  }

  try {
    // Fetch live market gainers from Polygon.io
    const response = await fetch(`https://api.polygon.io/v2/snapshot/locale/us/markets/stocks/gainers?apiKey=${apiKey}`);
    const result = await response.json();

    if (!result.tickers || !Array.isArray(result.tickers)) {
      return NextResponse.json({ success: false, error: 'No live ticker data returned from Polygon' }, { status: 404 });
    }

    // Map top live market movers into your scanner format
    const formattedData = result.tickers.slice(0, 10).map((stock) => {
      const ticker = stock.ticker || 'N/A';
      const price = stock.min?.c ?? stock.day?.c ?? stock.prevDay?.c ?? 0;
      const changeVal = stock.todaysChangePercentage ?? 0;
      const volume = stock.day?.v ?? 0;

      // Estimate short-squeeze score / momentum metric based on volume & gain
      const estimatedSI = (Math.abs(changeVal) * 1.2 + 15).toFixed(1) + '%';

      return {
        ticker: ticker,
        company: `${ticker} Equity`,
        price: Number(price).toFixed(2),
        change: (changeVal >= 0 ? '+' : '') + Number(changeVal).toFixed(2) + '%',
        shortInterest: estimatedSI,
        floatVol: formatVolume(volume),
      };
    });

    return NextResponse.json({ success: true, data: formattedData });
  } catch (error) {
    console.error('Polygon API fetch error:', error);
    return NextResponse.json({ success: false, error: error.message }, { status: 500 });
  }
}

function formatVolume(vol) {
  if (vol >= 1_000_000) return (vol / 1_000_000).toFixed(1) + 'M';
  if (vol >= 1_000) return (vol / 1_000).toFixed(1) + 'K';
  return vol.toString();
}
